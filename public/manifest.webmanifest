{
  "id": "/settings",
  "name": "Giganet Print Service",
  "short_name": "Giganet Print",
  "description": "Configuración del servicio local de impresión para macOS",
  "start_url": "/settings",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "es",
  "dir": "ltr",
  "background_color": "#0f1419",
  "theme_color": "#0f1419",
